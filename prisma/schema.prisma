generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  latitude    Float?
  longitude   Float?
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobType {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  category      String
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Source {
  id      String  @id @default(cuid())
  name    String  @unique
  baseUrl String
  active  Boolean @default(true)

  lastScraped   DateTime?
  announcements Announcement[]

  createdAt DateTime @default(now())
}

enum ListingType {
  OFFER
  PROFILE
}

enum WorkArrangement {
  NAVETTE
  LOGE_SUR_PLACE
}

enum WorkShift {
  JOUR
  NUIT
}

enum ContractDuration {
  TEMPORAIRE
  PERMANENT
}
enum SalaryPeriod {
  HEURE
  JOUR
  SEMAINE
  MOIS
}

model Announcement {
  id   String      @id @default(cuid())
  type ListingType

  source     Source  @relation(fields: [sourceId], references: [id])
  sourceId   String

 
  externalId String

  title       String
  description String?

  salaryMin    Float?
  salaryMax    Float?
  salaryPeriod SalaryPeriod?
  salaryRaw    String? 

  isUrgent Boolean @default(false)


  workArrangement WorkArrangement? 
  shift           WorkShift?       
  contractDuration ContractDuration? 

  transportAllowance Float? 

  isVerified Boolean @default(false) 
  isFeatured Boolean @default(false) 
  viewCount  Int     @default(0)

 
  workDays      String[] @default([])
  workStartTime String?  
  workEndTime   String?  

  desiredStartDate DateTime? 
  experienceYearsRequired Int? 

  city String? 
              

  language String @default("fr")

 
  region   Region? @relation(fields: [regionId], references: [id])
  regionId String?

  jobType   JobType @relation(fields: [jobTypeId], references: [id])
  jobTypeId String

  location String? 

 
  contactPhone    String?
  contactWhatsapp String?

  postedAt DateTime?
  url      String?
  rawData  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, externalId])
  @@index([type, jobTypeId, regionId])
  @@index([regionId, jobTypeId, postedAt])
  @@index([type, isUrgent])
  @@index([sourceId])
  @@index([postedAt])
  @@index([isFeatured])
  @@index([language])
}

model DailyStats {
  id   String   @id @default(cuid())
  date DateTime @unique

  totalAnnouncements Int @default(0)
  newAnnouncements   Int @default(0)

  regionStats  Json?
  jobTypeStats Json?

  createdAt DateTime @default(now())
}
model GlobalCounter {
  id                 String   @id @default("global")
  totalAnnouncements Int      @default(0)
  lastUpdated        DateTime @updatedAt
}
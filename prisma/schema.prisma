generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingType {
  OFFER
  PROFILE
}

enum WorkArrangement {
  NAVETTE
  LOGE_SUR_PLACE
}

enum WorkShift {
  JOUR
  NUIT
}

enum ContractDuration {
  TEMPORAIRE
  PERMANENT
}

enum SalaryPeriod {
  HEURE
  JOUR
  SEMAINE
  MOIS
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum ClientType {
  INDIVIDUAL
  AGENCY
}

enum ProviderType {
  BABYSITTER
  GARDE_PERISCOLAIRE
  MENAGE
  AIDE_PERSONNES_AGEES
  RESIDENTIEL
  COURT_TERME
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_OTP
}

enum ConsentType {
  LOCATION_ACCESS
  NO_VPN
  VR_CONFERENCE
  TERMS_OF_USE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RecurrenceType {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationLevel {
  BASIC
  ADVANCED
  PREMIUM
}

model Region {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  latitude      Float?
  longitude     Float?
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("regions")
}

model JobType {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  category      String
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("job_types")
}

model Source {
  id            String         @id @default(cuid())
  name          String         @unique
  baseUrl       String
  active        Boolean        @default(true)
  lastScraped   DateTime?
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("sources")
}

model Announcement {
  id   String      @id @default(cuid())
  type ListingType

  source   Source @relation(fields: [sourceId], references: [id])
  sourceId String

  externalId String

  title       String
  description String? @db.Text

  salaryMin    Decimal?      @db.Decimal(10, 2)
  salaryMax    Decimal?      @db.Decimal(10, 2)
  salaryPeriod SalaryPeriod?
  salaryRaw    String?

  isUrgent Boolean @default(false)

  workArrangement  WorkArrangement?
  shift            WorkShift?
  contractDuration ContractDuration?

  transportAllowance Decimal? @db.Decimal(10, 2)

  isVerified Boolean @default(false)
  isFeatured Boolean @default(false)
  viewCount  Int     @default(0)

  workDays      String[] @default([])
  workStartTime String?
  workEndTime   String?

  desiredStartDate        DateTime?
  experienceYearsRequired Int?

  city String?

  language String @default("fr")

  region   Region? @relation(fields: [regionId], references: [id])
  regionId String?

  jobType   JobType @relation(fields: [jobTypeId], references: [id])
  jobTypeId String

  location String?

  contactPhone    String?
  contactWhatsapp String?

  postedAt DateTime?
  url      String?
  rawData  Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, externalId])
  @@index([type, jobTypeId, regionId])
  @@index([regionId, jobTypeId, postedAt])
  @@index([type, isUrgent])
  @@index([sourceId])
  @@index([postedAt])
  @@index([isFeatured])
  @@index([language])
  @@index([userId])
  @@map("announcements")
}

model DailyStats {
  id   String   @id @default(cuid())
  date DateTime @unique

  totalAnnouncements Int @default(0)
  newAnnouncements   Int @default(0)

  regionStats  Json?
  jobTypeStats Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("daily_stats")
}

model GlobalCounter {
  id                 String   @id @default("global")
  totalAnnouncements Int      @default(0)
  lastUpdated        DateTime @updatedAt

  @@map("global_counters")
}

model User {
  id    String  @id @default(cuid())
  name  String?
  email String? @unique

  emailVerified    Boolean @default(false)
  phone            String? @unique
  phoneCountryCode String? @default("+225")

  phoneVerified Boolean @default(false)
  password      String?
  image         String?
  accountType   Role    @default(CLIENT)

  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  clientType  ClientType?
  companyName String?
  rccmNumber  String?

  providerType ProviderType?
  bio          String?
  isActive     Boolean       @default(true)
  hourlyRate   Decimal?      @db.Decimal(10, 2)
  currency     String        @default("XOF")

  verificationStatus VerificationStatus @default(PENDING)
  verificationLevel  VerificationLevel?
  verifiedBy         String?
  verifiedAt         DateTime?
  verificationNotes  String?            @db.Text

  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  consents UserConsent[]

  bookingsAsClient   Booking[] @relation("ClientBookings")
  bookingsAsProvider Booking[] @relation("ProviderBookings")

  reviewsGiven    Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewReceiver")

  favoriteProviders Favorite[] @relation("ClientFavorites")
  favoritedBy       Favorite[] @relation("ProviderFavorited")

  availabilities   Availability[]
  unavailableDates UnavailableDate[]

  announcements Announcement[]

  @@index([accountType])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model UserConsent {
  id         String      @id @default(cuid())
  userId     String
  type       ConsentType
  accepted   Boolean     @default(false)
  acceptedAt DateTime?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("user_consents")
}

model Favorite {
  id         String   @id @default(cuid())
  clientId   String
  providerId String
  createdAt  DateTime @default(now())

  client   User @relation("ClientFavorites", fields: [clientId], references: [id], onDelete: Cascade)
  provider User @relation("ProviderFavorited", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([clientId, providerId])
  @@index([providerId])
  @@index([clientId])
  @@map("favorites")
}

model Availability {
  id          String    @id @default(cuid())
  providerId  String
  dayOfWeek   DayOfWeek
  startTime   String    @db.VarChar(5)
  endTime     String    @db.VarChar(5)
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek, startTime, endTime])
  @@index([providerId, dayOfWeek])
  @@map("availabilities")
}

model UnavailableDate {
  id         String   @id @default(cuid())
  providerId String
  date       DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, date])
  @@index([providerId, date])
  @@map("unavailable_dates")
}

model Booking {
  id          String        @id @default(cuid())
  clientId    String
  providerId  String
  serviceType ProviderType
  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(PENDING)
  notes       String?       @db.Text

  recurrenceType RecurrenceType @default(ONE_TIME)
  recurrenceEnd  DateTime?

  hourlyRate  Decimal? @db.Decimal(10, 2)
  totalAmount Decimal? @db.Decimal(10, 2)
  currency    String   @default("XOF")

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paymentDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   User @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  provider User @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)

  reviews Review[]

  @@index([clientId])
  @@index([providerId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([paymentStatus])
  @@map("bookings")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String
  authorId   String
  receiverId String
  rating     Int      @db.SmallInt
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author   User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReviewReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([bookingId, authorId])
  @@index([receiverId])
  @@index([authorId])
  @@map("reviews")
}

model VerifiedPhone {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  operator    Operator
  isActive    Boolean  @default(true)
  verifiedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([operator])
  @@index([phoneNumber])
  @@map("verified_phones")
}

enum Operator {
  ORANGE
  MOOV
  MTN
  UNKNOWN
}

model RateLimit {
  id          String @id @default(uuid())
  key         String
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}
